<script type="text/javascript" src="/js/jquery-ui-1.8.12.custom.min.js"></script>
<link rel="stylesheet" type="text/css" href="/css/jquery-ui-1.8.12.custom.css"/>
<script>
    $(document).ready(function () {
    	$('[type="reset"]').click(function(){
    		$('input').val('');
    		$('select').val(0);
    		$('form.form-search').submit();
    	});

    	$( '.date' ).datepicker({ dateFormat: "dd/mm/yy" });

        $('#area_id').change(function(){
            $(this).after('<span class="loading"></span>');
            var _self = $(this);
            var area_id = $(this).val();
            $.get("/staff/load-province",
                {area_id: area_id}
                ,function(data,status){
                    var obj = $.parseJSON( data );
                    $('#regional_market').find('option:not(:first)').remove();
                    for (var i = 0; i < obj.length; i++) {
                        $('#regional_market').append('<option value="'+obj[i]['id']+'">'+obj[i]['name']+'</option>');
                    }
                    _self.nextAll('.loading').remove();
                });
        });

        $('#regional_market').change(function(){
            $(this).after('<span class="loading"></span>');
            var _self = $(this);
            var regional_market = $(this).val();
            $.get("/staff/load-sales-team",
                {regional_market: regional_market}
                ,function(data,status){
                    var obj         = $.parseJSON( data );
                    var stores      = obj.stores;
                    $('#store').find('option:not(:first)').remove();
                    for (var i = 0; i < stores.length; i++) {
                        $('#store').append('<option value="'+stores[i]['id']+'">'+stores[i]['name']+'</option>');
                    }

                    $('.loading').remove();
                });
        });

        <?php if(in_array( $this->user_group, array(ASM_ID, ASMSTANDBY_ID) )): ?>
	        $('#area_id_first').change(function(){
	            $(this).after('<span class="loading"></span>');
	            var _self = $(this);
	            var area_id = $(this).val();
	            $.get("/staff/load-province",
	                {area_id: area_id}
	                ,function(data,status){
	                    var obj = $.parseJSON( data );
	                    $('#regional_market_first').find('option:not(:first)').remove();
	                    for (var i = 0; i < obj.length; i++) {
	                        $('#regional_market_first').append('<option value="'+obj[i]['id']+'">'+obj[i]['name']+'</option>');
	                    }
	                    _self.nextAll('.loading').remove();
	                });
	        });

	        $('#regional_market_first').change(function(){
	            $(this).after('<span class="loading"></span>');
	            var _self = $(this);
	            var regional_market = $(this).val();
	            $.get("/staff/load-sales-team",
	                {regional_market: regional_market}
	                ,function(data,status){
	                    var obj         = $.parseJSON( data );
	                    var stores      = obj.stores;
	                    $('#store_first').find('option:not(:first)').remove();
	                    for (var i = 0; i < stores.length; i++) {
	                        $('#store_first').append('<option value="'+stores[i]['id']+'">'+stores[i]['name']+'</option>');
	                    }

	                    $('.loading').remove();
	                });
	        });
        <?php endif; ?>
    });
</script>