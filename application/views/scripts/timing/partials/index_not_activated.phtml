<div id="modal" class="modal hide fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
	<div class="modal-header">
	  <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
	  <h3 id="myModalLabel">Timing Note</h3>
	</div>
	<div class="modal-body">
		<div class="control-group">
			<div class="controls">
				<textarea disabled="disabled" name="note_content" id="note_content" class="form-control note_content" rows="10"></textarea>
			</div>
		</div>
		<div class="control-group">
			<label for="note">Add a note</label>
			<div class="controls">
				<textarea name="note" id="note" class="form-control note_content" rows="4"></textarea>
				<input type="hidden" name="note_id" id="note_id" value="" />
			</div>
		</div>
		
	</div>
	<div class="modal-footer">
	  <button class="btn btn-success" id="btn_save" aria-hidden="true">Save</button><button class="btn" data-dismiss="modal" aria-hidden="true">Close</button>
	</div>
</div>

<div id="timing_modal" class="modal hide fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">

</div>
<script type="text/javascript">
    $modal = $('#modal');
	$timing_modal = $('#timing_modal');
	
	$('.note_label').click(function(){
	    var _self = $(this);

	    $('body').modalmanager('loading');
	    $('#note_content').html(_self.data('note'));
	    $('#note_id').val(_self.data('timing-id'));
	    $modal.modal('loading');

	    $.post('<?php echo HOST ?>/timing/update-note',
            {
				id   : $('#note_id').val(),
				read : 1
            },
            function(data){
        		$modal.modal();
        		$modal.modal('loading');

        		if (_self.hasClass('label-info') || _self.hasClass('label-warning')) {
        			_self.next('.icon-eye-open').remove();
        			_self.after('<i class="icon-eye-open"></i>');
        			_self.removeClass('label-warning').addClass('label-info').html('Note');
        		}
    		}
    	);
	});

	$('#btn_save').click(function(){
		var _note_text = $('#note').val().trim();
		if (_note_text.length == 0) {
			$modal.modal('hide');
		} else {
			$modal.modal('loading');
			$.post('<?php echo HOST ?>/timing/update-note',
	            {
					id   : $('#note_id').val(),
					note : _note_text
	            },
	            function(data){
	            	if (data == 1) {
	            		$('#note_content').append("\n"+_note_text);
	            		$('#note').val('');
						$modal
							.modal('loading')
							.find('.modal-body')
					        .prepend('<div class="alert alert-info fade in">' +
					          'Updated!<button type="button" class="close" data-dismiss="alert">&times;</button>' +
					        '</div>');
	            	} else {
            			$modal
                            .modal('loading')
							.find('.modal-body')
					        .prepend('<div class="alert alert-error fade in">' +
					          'Update failed! Try again.<button type="button" class="close" data-dismiss="alert">&times;</button>' +
					        '</div>');
	            	}
	                
        		}
        	);
		}		
	});


	$('.approve').click(function (e){
		e.preventDefault();
		var _self = $(this);
		$.post( _self.attr('href'), function( data ) {
			if (data==0){
				_self.parent().prev().prev().html('<span class="label label-success">Approved</span>');
				_self.replaceWith('<i class="icon-ok">');
			} else if (data==2){

                alert('Bạn chỉ có thể approve báo cáo của ngày hôm nay và <?php $day_limit = ceil( TIME_LIMIT_TIMING/(24*60*60) ); echo $day_limit;?> ngày trước.');
            } else if (data == -69) {
            	alert('Chỉ SALES mới có quyền Approve!');

            } else if (data == 3) {
            	alert('Báo cáo không tồn tại!');

            } else if (data == 4) {

            	alert('Bạn không phải người quản lý của PG/PB tại thời điểm báo cáo!');
            }
		});
	});

	$('.product_count').tooltip();

    $(document).ready(function() {
        check_fake_report();
        
    });

    function check_fake_report() {
        len = $('.check_imei').length;

        $('.check_imei').each(function(index, element) {
            $(element).append('<span class="loading"></span>');

            $.post('<?php echo HOST ?>ajax/check-fake-report', {
                timing_id: $(element).data('timing-id')
            }, function(data) {
                $(element).find('.loading').remove();
                $(element).append('<button class="btn btn-danger btn-mini remove_imei_btn" data-timing-id="'+$(element).data('timing-id')+'">Remove</button>');
                
                if (!--len) {
                    show_timing();
                }
            });

        });
    }

    function show_timing() {
        $('.remove_imei_btn').click(function() {
            timing_id = $(this).data('timing-id');
            $('body').modalmanager('loading');

            $.post('<?php echo HOST ?>ajax/show-timing', {
                timing_id: timing_id
            }, function(data) {
                $('#timing_modal').html(data);
                $timing_modal.modal();
            });
        });
    }
</script>
<script type="text/javascript" src="/js/jquery-ui-1.8.12.custom.min.js"></script>
<link rel="stylesheet" type="text/css" href="/css/jquery-ui-1.8.12.custom.css"/>
