<table class="table table-bordered">
    <thead>
        <tr>
            <?php echo $this->sorting(array(
				'#', 
				'name'              => 'Name',
				's.regional_market' => 'Province',
				's.phone_number'    => 'Phone Number',
				's.email'           => 'Email',
				'p.from'            => 'Date',
				'p.store'           => 'Store',
				'p.id'              => 'Timing At',
				'p.updated_at'      => 'Updated At',
				'p.status'          => 'Status',
				'Note',
				'Action'
                ),
            $this->url, $this->current_col, $this->desc); ?>
        </tr>
    </thead>
    <tbody>
        <?php
        if (isset($this->timings) and $this->timings)
            foreach ($this->timings as $k=>$timing): ?>
        <tr>
            <td>
                <?php
                    $inc = $this->offset + $k + 1;
                    echo $inc;
                ?>
            </td>
            <td><p data-toggle="tooltip" class="product_count" title="<?php echo "Sales this month: " . (!empty($this->product_count[$timing['staff_id']]) ? $this->product_count[$timing['staff_id']] : '0') ?>">
                <?php echo $timing['firstname'].' '.$timing['lastname'];?>
                </p>
            </td>
            <td><?php if(isset($this->regional_market_all) && isset($this->regional_market_all[$timing['regional_market']])) echo $this->regional_market_all[$timing['regional_market']];?></td>
            <td><?php echo $timing['phone_number'];?></td>
            <td><?php @list($email, $domain) = @explode('@',$timing['email']); echo $email;?></td>
            <td><?php echo ($timing['from'] ? date('d/m/Y', strtotime($timing['from'])) : '');?></td>
            <td><?php if(isset($this->store_cached) && isset($this->store_cached[$timing['store']])) echo $this->store_cached[$timing['store']];?></td>
            <td><?php echo ($timing['created_at'] ? date('d/m/Y H:i:s', strtotime($timing['created_at'])) : '');?></td>
            <td>
                <?php if ($timing['updated_at']): ?>
                    <?php echo '<span class="label label-warning">'.date('d/m/Y H:i:s', strtotime($timing['updated_at'])).'</span>' ?>
                <?php endif ?>
            </td>
            <td><?php if ($timing['status']==1): ?><span class="label label-success">Approved</span><?php else: ?><span class="label">Pending</span><?php endif;?></td>
