    function initChangeProduct(){
        $( '.product' ).change(function (){
            var _self = $(this);
            var product_id = $(this).val();
            var obj = model_arr[product_id];
            var next_model = _self.parent().next().children('.model');

            if (typeof next_model.attr('class') == 'undefined')
                var next_model = _self.next();

            next_model.find('option:not(:first)').remove();
            for (var i = 0; i < obj.length; i++) {
                next_model.append('<option value="'+obj[i]['id']+'">'+obj[i]['model']+'</option>');
            }
        });
    }

