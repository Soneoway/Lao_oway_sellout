    function format_imei() {
    	$('input[name="imei[]"]').keyup(function() {
    		_self = $(this);
    		imei = _self.val().trim();
    		_self.val(imei);
    	});
    }

    function init_get_store() {
        $('#date').on('change', function(event) {
            date = $('#date').val().trim();

            if (date != '') {
                get_store(date);
            }
        });

        $('#inputDate').on('change', function(event) {
            date = $('#inputDate').val().trim();

            if (date != '') {
                get_store_notify(date);
            }
        });
    }

    function get_store(date) {
        $('form#timing_form button[type=submit]').prop('disabled', true);
        $('#store').html('<option value>Loading...<option>');

        $.post('<?php echo HOST . "ajax/get-store" ?>', {
            timing_time: date
        }, function(data) {
            $('form#timing_form button[type=submit]').prop('disabled', false);
            $('#store').html(data);

            if ( $('#store option').length == 1 ) {
                $('#store').prop('disabled', true);
            } else {
                $('#store').prop('disabled', false);
            }
        });
    }

    function get_store_notify(date) {
        $('form#timing_form button[type=submit]').prop('disabled', true);
        $('#inputStore').html('<option value>Loading...<option>');

        $.post('<?php echo HOST . "ajax/get-store" ?>', {
            timing_time: date
        }, function(data) {
            $('form#timing_form button[type=submit]').prop('disabled', false);
            $('#inputStore').html(data);

            if ( $('#inputStore option').length == 1 ) {
                $('#inputStore').prop('disabled', true);
            } else {
                $('#inputStore').prop('disabled', false);
            }
        });
    }
