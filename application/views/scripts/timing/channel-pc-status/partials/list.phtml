<?php 

    $d1 = explode('/', $this->params['from']);
    $from = $d1[2].'-'.$d1[1].'-'.$d1[0];

    $d2 = explode('/', $this->params['to']);
    $to = $d2[2].'-'.$d2[1].'-'.$d2[0];

    $period_loop = ( (strtotime($to) - strtotime($from)) / (24*60*60) ) + 1;

    // echo $period_loop; echo "<br/>";
    // print_r($this->channel_pc_status);

    $data = array();
    if (isset($this->channel_pc_status) and $this->channel_pc_status) { $data = $this->channel_pc_status; }
?>


