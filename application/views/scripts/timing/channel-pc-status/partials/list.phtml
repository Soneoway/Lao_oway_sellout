    <thead>
    <tr>
        <th width="5%"><div align="center">No.</div></th>
        <th width="12%"><div align="center">Area</div></th>
        <th width="6%"><div align="center">Store ID</div></th>
        <th><div align="center">Store Name</div></th>
        <th width="12%"><div align="center">Store Type</div></th>
        <th width="5%"><div align="center">PC</div></th>

        <?php 

            for ($i=0;$i<$period_loop;$i++) {
                $day_text =  date('d-M', strtotime("+".$i." Day", strtotime($from)));        
                echo "<th width='5%'><div align='center'>".$day_text."</div></th>";
            }

        ?>

    </tr>
    </thead>
    <tbody>
    <?php

    if ( !empty($data) ) {

        $QStoreStaff = new Application_Model_StoreStaff();

        foreach ($data as $key => $value) {

            $inc = $this->offset + $key + 1;

            $result_pc = $QStoreStaff->getPC($value['st_id'],0);
            $cnt_pc = count($result_pc);

            echo "<tr>";
            echo    "<td><div align='center'>".$inc."</td>";
            echo    "<td><div align='center'>".$value['area_name']."</td>";
            echo    "<td><div align='center'>".$value['st_id']."</td>";
            echo    "<td><div align='left'>".$value['st_name']."</td>";
            echo    "<td><div align='center'>".$value['st_type']."</td>";
            echo    "<td><div align='center'>".$cnt_pc."</td>";

            for ($i=0;$i<$period_loop;$i++) {
                $day_text =  date('d-M', strtotime("+".$i." Day", strtotime($from)));        
                echo "<td><div align='center'>".$value[$day_text]."</div></th>";
            }
            
            echo "</tr>";
        }
    }

    ?>
    </tbody>
</table>
