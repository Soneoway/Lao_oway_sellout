    function check_warrant() {

        $('.chk_warrant').change(function() {

            var _self = $(this);
            var next_model = _self.parent().find('.warrant');

            if (_self.val() == 1) { 
                next_model.removeAttr('readonly');
                next_model.attr('required','required');
                next_model.css('display','block');
            } else { 
                next_model.val('');
                next_model.removeAttr('required');
                next_model.attr('readonly','readonly');
                next_model.css('display','none'); 
            } 

        });
        
    }

