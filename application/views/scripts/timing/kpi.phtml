<script type="text/javascript">
function search() {
    var formdata = jQuery("form").serialize();
    var decoded = decodeURIComponent(formdata);
    strip = decoded.replace(/[\[\]]/g, "_");

    //get ajax content
    if ($(".load-ajax").length){
        $(this).after("<span class=\'loading\'></span>");
        $.ajax({
            url: '<?php echo HOST ?>timing/kpi',
            type: 'get',
            dataType: 'html',
            data: strip,
        })
        .done(function(data) {
            console.log("success");
            $(".load-ajax").html(data);
            $(".loading").remove();
        })
        .fail(function() {
            console.log("error");
        })
        .always(function() {
            console.log("complete");
        });
        
    } else
        window.location.href = strip;

    return false;    
}

;(function($) {
