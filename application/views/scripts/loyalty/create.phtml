<script type="text/javascript">
    function initDateRange(){
        $('.datetimepicker').dateRangePicker({
            separator : ' to ',
            getValue: function()
            {
                if ($('#from_date').val() && $('#to_date').val() )
                    return $('#from_date').val() + ' to ' + $('#to_date').val();
                else
                    return '';
            },
            setValue: function(s,s1,s2)
            {
                $('#from_date').val(s1);
                $('#to_date').val(s2);
            },
            shortcuts :
            {
                'prev-days': [7],
                'prev': ['week','month'],
                'next-days':null,
                'next':null
            }
        });
    }

    $(document).ready(function () {
        initDateRange();

    });
</script>