<script type="text/javascript">
;(function($) {
    $('.reimport_btn').click(reimport);

    function reimport(e) {
        if ( ! $(e.target).hasClass('reimport_btn') )
            _self = $(e.target).parents('.reimport_btn');
        else
            _self = $(e.target);

        imei  = _self.data('imei');
        id    = _self.data('id');
        _item = _self.parents('.item');
        $('.loading').remove();
        _item.find('.status').html('');

        _item.find('.status').html('<span class="loading"></span>');

        $.ajax({
            url: '<?php echo HOST ?>timing/expired-submit',
            type: 'post',
            dataType: 'json',
            data: {
                id: id,
                imei: imei
            },
        })
        .done(function(data) {
            console.log("success");

            if (data && data.code == 1) {
                _self.remove();
                _item.find('.status').text('Done');
            } else {
                _item.find('.status').text('[' +data.code +'] '+ data.message);
            }
        })
        .fail(function() {
            console.log("error");
        })
        .always(function() {
            $('.loading').remove();
            console.log("complete");
        });
        
    }
})(jQuery);
</script>