<script>
$(document).ready(function(){
    $('.date' ).datepicker({ dateFormat: "yy-mm-dd" });
    getShop();
    addPictureListPG();
    addPictureTraining();
    minusPicture();
    delPicture();
    initSearchOption('dealer','search_dealer');
    typeTrainingReport();
    getProvince();
    init();
    autoMinus();
});
function init()
{
    initWaiting();
    var type = '<?php echo (isset($this->info_training_report['type']) and $this->info_training_report['type'] ) ? $this->info_training_report['type']:null ?>';
    initType(type);
    initRequired(type);
    unblockUI();
}
function getShop()
{
    $('#dealer').change(function(){
       var dealer_id =  $('#dealer').val();
        $.ajax
        ({
            url : '/trainer/get-shop',
            type : 'POST',
            data : {'dealer_id':dealer_id},
            dataType: 'json',
            success : function(result)
            {
                $('#store').find('option:not(:first)').remove();
                $.each(result, function (i, item) {
                    $('#store').append('<option value="'+i+'">'+item+'</option>');
                });
            },
            error: function()
            {
                alert("Not Found !!!");
            }

        });
    });
}
function getProvince()
{
    $('#area').change(function(){
        var area =  $('#area').val();
        var staff_id =  '<?php echo (isset($this->staff_id) ? $this->staff_id :null)?>';
        initWaiting();
        $.ajax
        ({
            url : '/trainer/get-province',
            type : 'POST',
            data : {'staff_id':staff_id,'area':area},
            dataType: 'json',
            success : function(result)
            {
                $('#province').find('option:not(:first)').remove();
                $.each(result, function (i, item) {
                    $('#province').append('<option value="'+i+'">'+item+'</option>');
                });
                unblockUI();
            },
            error: function()
            {
                alert("Not Found !!!");
                unblockUI();
            }

        });
    });
}
function addPictureTraining()
{
    $('#add_picture_training').click(function(){
        var row = '<tr><td><input type="file" name="picture_training[]" value=""/></td><td><input type="button" class="btn btn-danger minus" value="-"/></td></tr>';
        $('#table_picture_training').append(row);
        minusPicture();
    });
}
function addPictureListPG()
{
    $('#add_picture_list_pg').click(function(){
        var row = '<tr><td><input type="file" name="picture_list_pg[]" value=""/></td><td><input type="button" class="btn btn-danger minus" value="-"/></td></tr>';
        $('#table_picture_pg_list').append(row);
        minusPicture();
    });
}
function minusPicture()
{
    $('.minus').click(function(){

        $(this).parent().parent().remove();
    });
}
function delPicture()
{
    $('.del').click(function(){
        var id = $(this).attr('rel');
        $('#'+id).remove();
    });
}

function typeTrainingReport()
{
    $('#type').change(function(){
       var type =  $('#type').val();
       initType(type);
       initRequired(type);
    });
}
function initWaiting()
{
    $.blockUI({ css: {
        border: 'none',
        padding: '15px',
        backgroundColor: '#000',
        '-webkit-border-radius': '10px',
        '-moz-border-radius': '10px',
        opacity: .5,
        color: '#fff'
    } });
}
function unblockUI()
{
    $.unblockUI();
}
function initType(type)
{
    var type_internally = '<?php echo TRAINING_REPORT_INTERNALLY?>';
    var type_partner    = '<?php echo TRAINING_REPORT_PARTNERS?>';
    var type_new_staff  = '<?php echo TRAINING_REPORT_NEW_STAFF?>';

    if(type == type_internally)
    {
        $('#partners').hide();
        $('#new_staff').hide();
        $('#internally').show();
        $('#date').show();
        $('#quantity_trainees').show();
    }
    else if(type == type_partner)
    {
        $('#partners').show();
        $('#new_staff').hide();
        $('#internally').hide();
        $('#date').show();
        $('#quantity_trainees').show();
    }
    else if(type == type_new_staff)
    {
        $('#partners').hide();
        $('#new_staff').show();
        $('#internally').hide();
        $('#date').hide();
        $('#quantity_trainees').hide();
    }
    else
    {
        $('#partners').hide();
        $('#new_staff').hide();
        $('#internally').hide();
        $('#date').hide();
        $('#quantity_trainees').hide();
    }
}
function initRequired(type)
{
    var type_internally = '<?php echo TRAINING_REPORT_INTERNALLY?>';
    var type_partner    = '<?php echo TRAINING_REPORT_PARTNERS?>';
    var type_new_staff  = '<?php echo TRAINING_REPORT_NEW_STAFF?>';

    if(type == type_internally)
    {
        $('#_date').attr("required", "true");
        $('#dealer').removeAttr('required');
        $('#store').removeAttr('required');
        $('#area').attr('required','true');
        $('#province').attr('required','true');
        $('#from_date').removeAttr('required');
        $('#to_date').removeAttr('required');
        $('#quantity_participant').removeAttr('required');
        $('#quantity_disqualified').removeAttr('required');
        $('#quantity_remain').removeAttr('required');
        $('#_quantity_trainees').attr('required','true');
    }
    else if(type == type_partner)
    {
        $('#_date').attr('required','true');
        $('#dealer').attr('required','true');
        $('#store').attr('required','true');
        $('#area').removeAttr('required');
        $('#province').removeAttr('required');
        $('#from_date').removeAttr('required');
        $('#to_date').removeAttr('required');
        $('#quantity_participant').removeAttr('required');
        $('#quantity_disqualified').removeAttr('required');
        $('#quantity_remain').removeAttr('required');
        $('#_quantity_trainees').attr('required','true');
    }
    else if(type == type_new_staff)
    {
        $('#_date').removeAttr('required');
        $('#dealer').removeAttr('required');
        $('#store').removeAttr('required');
        $('#area').removeAttr('required');
        $('#province').removeAttr('required');
        $('#from_date').attr('required','true');
        $('#to_date').attr('required','true');
        $('#quantity_participant').attr('required','true');
        $('#quantity_disqualified').attr('required','true');
        $('#quantity_remain').attr('required','true');
        $('#_quantity_trainees').removeAttr('required');
    }

}
function autoMinus()
{
    $('#quantity_disqualified').change(function(){
        var value_quantity_participant = $('#quantity_participant').val();
        var value_quantity_disqualified = $('#quantity_disqualified').val();
        if(value_quantity_disqualified > value_quantity_participant)
        {
            alert('Quantity Disqualified > Quantity Participant');
        }
        else
        {
            var remain = value_quantity_participant - value_quantity_disqualified;
            $('#quantity_remain').val(remain);
        }

    });

}
</script>
