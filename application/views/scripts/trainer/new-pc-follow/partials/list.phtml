    function getStatus($status)
    {
        if ($status == "Y") {
            $result = '<storng style="color: #00aa00">PASS</storng>';
        } else {
            $result = '<storng style="color: #ea0100">NOT PASS</storng>';
        }
        return $result;
    }

    function checkCountDown($num, $expire_status)
    {
        if ($expire_status == 'Y') {
            $result = "เกินมา " . ($num - 45) . " วัน";
        } else {
            $result = "เหลือเวลา " . (45 - $num) . " วัน";
        }
        return $result;
    }

