<script>
    $(document).ready(function () {
        $modal = $('#modal');
        $('.view_details').click(function () {

            _self = $(this);
            $('body').modalmanager('loading');
            var mData = {
                id: _self.data('id'),
                round: _self.data('round')
            };

            $.post('<?php echo HOST ?>trainer/new-pc-follow-detail', mData, function (data) {
                $modal.html(data);
                $modal.modal();
            });
        });
    });
</script>
