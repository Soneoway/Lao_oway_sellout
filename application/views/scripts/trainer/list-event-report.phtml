<script>
    $(document).ready(function(){
        view();
    });
    function view()
    {
        $('.view_event_report').click(function(){
            var id = $(this).attr('rel');
            if(id)
            {
                $.ajax
                ({
                    url : '/trainer/get-info-event-report',
                    type : 'POST',
                    data : {'id':id},
                    async: false,
                    success : function (result)
                    {
                        $('#body_modal').empty();
                        $('#body_modal').append(result);
                        $('#myModal').modal();
                    },
                    error : function ()
                    {
                        alert('Can not found Value !');
                    }
                });
            }
            else
            {
                alert('Can not found ID');
            }

        });
    }
</script>

