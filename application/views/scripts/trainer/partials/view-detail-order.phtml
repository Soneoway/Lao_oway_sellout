            <tr>
                <td class="span1">Quantity</td>
                <td class="span3">
                    <input type="number" name="quantity[]" disabled value="<?php echo (isset($value['quantity']) and $value['quantity'])? $value['quantity']:'' ?>"/>
                </td>
                <td class="span2">Note</td>
                <td class="span4">
                    <textarea name="note[]" disabled><?php echo (isset($value['note']) and $value['note'])? $value['note']:'' ?></textarea>
                </td>
