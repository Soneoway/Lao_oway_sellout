<script>
    $(document).ready(function(){
        getInfoPGSALE();
    });
    function getInfoPGSALE()
    {
        $('.information_pg_sale').click(function()
        {
            var staff_id = $(this).attr('rel');
            initWaiting();
            $.ajax
            ({
                url : '/trainer/get-info-pg-sale',
                type : 'POST',
                data : {'staff_id': staff_id},
                async: false,
                dataType: "json",
                success : function (result)
                {
                    if(result.facebook_id)
                    {
                        var init_facebookID = result.facebook_id;
                        if(init_facebookID != null || init_facebookID != undefined )
                        {
                            FB.api('/'+init_facebookID.trim(), function(response) {
                                if(response)
                                {
                                    $('#'+staff_id+'_modal').find('#facebook').empty();
                                    $('#'+staff_id+'_modal').find('#facebook').append('<table class="table"><tr><td class="span2" colspan="2"><img src="https://graph.facebook.com/'+init_facebookID.trim()+'/picture?type=large&return_ssl_results=1" /></td></tr></table>');
                                    $('#'+staff_id+'_modal').find('#facebook').append('<table class="table"><tr><td class="span1"><b>Name:</b></td><td class="span2">'+response.name+'</td></tr></table>');
                                    $('#'+staff_id+'_modal').find('#facebook').append('<table class="table"><tr><td class="span1"><b>Gender:</b></td><td class="span2">'+response.gender+'</td></tr></table>');
                                }
                            });
                        }
                    }

                    var knowledge = result.knowledge ? result.knowledge : '';
                    var skill     = result.skill ? result.skill : '';
                    var attitude  = result.attitude ? result.attitude :'';

                    if(knowledge)
                    {
                        $('#'+staff_id+'_modal').find('#knowledge').empty();
                        $('#'+staff_id+'_modal').find('#knowledge').append('<table class="table"><tr><td class="span1"><b>Knowledge:</b></td><td class="span2">'+knowledge+'</td></tr></table>');
                    }
                    if(skill)
                    {
                        $('#'+staff_id+'_modal').find('#skill').empty();
                        $('#'+staff_id+'_modal').find('#skill').append('<table class="table"><tr><td class="span1"><b>Skill:</b></td><td class="span2">'+skill+'</td></tr></table>');
                    }

                    if(attitude)
                    {
                        $('#'+staff_id+'_modal').find('#attitude').empty();
                        $('#'+staff_id+'_modal').find('#attitude').append('<table class="table"><tr><td class="span1"><b>Attitude:</b></td><td class="span2">'+attitude+'</td></tr></table>');
                    }


                    if(result.point != undefined )
                    {
                        $('#'+staff_id+'_modal').find('#modal_point').empty();
                        $('#'+staff_id+'_modal').find('#modal_point').html('<table class="table table-bordered"><tr><td class="span1">Point</td><td class="span1">Month</td><td class="span1">Year</td></tr></table>');

                        for(i=0; i < result.point['point'].length; i++)
                        {
                            $('#'+staff_id+'_modal').find('#modal_point').append('<table class="table"><tr><td class="span1">'+result.point['point'][i]+'</td><td class="span1">'+result.point['month'][i]+'</td><td class="span1">'+result.point['year'][i]+'</td></tr></table');
                        }
                    }

                    if(result.reward_warning != undefined )
                    {
                        $('#'+staff_id+'_modal').find('#reward_warning').empty();
                        $('#'+staff_id+'_modal').find('#reward_warning').html('<table class="table table-bordered"><tr><td class="span2">Type</td><td class="span1">Month</td><td class="span1">Year</td><td>Content</td></tr></table>');

                        for(i=0; i < result.reward_warning['type'].length; i++)
                        {
                            $('#'+staff_id+'_modal').find('#reward_warning').append('<table class="table"><tr><td class="span2">'+result.reward_warning['type'][i]+'</td><td class="span1">'+result.reward_warning['month'][i]+'</td><td class="span1">'+result.reward_warning['year'][i]+'</td><td><div class="span2">'+result.reward_warning['content'][i]+'</div></td></tr></table>');
                        }
                    }

                    unblockUI();

                    $('#'+staff_id+'_modal').modal();

                },
                error : function ()
                {
                    console.log('loi');
                }
            });

        });


    }
    function unblockUI(){
        $.unblockUI();
    }
    function initWaiting(){
        $.blockUI({ css: {
            border: 'none',
            padding: '15px',
            backgroundColor: '#000',
            '-webkit-border-radius': '10px',
            '-moz-border-radius': '10px',
            opacity: .5,
            color: '#fff'
        } });
    }

</script>