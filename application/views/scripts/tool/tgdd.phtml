<script>
    var iid;

    function confirmExit() {
        return "Timings is processing...";
    }

    function get_status () {
        $.get('<?php echo HOST ?>files/timing/<?php echo $this->uid ?>/status.txt', function(data) {
            $('.bar').css('width', data+'%');
            $('.bar').html(data+'%');
        });
    }

    function do_interval() {
        return window.setInterval(get_status, 2000);
    }

    function clear_interval() {
        window.clearInterval(iid);
        $('.bar').css('width', '0%');
        $('.bar').html('');
    }

    $(document).ready(function () {
        $('form').bind('submit',function(e){
            $('.bar').css('width', '0%');
            $('.bar').html('');
            $('#iframe').get(0).contentWindow.clear_content();
            $('form button, form input, form select').prop('readonly', true);
            $('.loading').remove();
            $(this).after('<span class="pre_loading">Processing <span><span class="loading"></span>');
            window.onbeforeunload = confirmExit;

            iid = do_interval();
        });
    });
</script>