    ;(function($){
        parent.$('.loading, .pre_loading').remove();
        parent.$('form button, form input, form select').prop('readonly', false);
        parent.window.onbeforeunload = null;
    })(jQuery);

    function clear_content() {
        document.getElementById('content_wrapper').innerHTML = '';
    }
