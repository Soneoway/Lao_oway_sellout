<script type="text/javascript">
    function initChoose(){
        <?php
            if ($this->exception_case->value and $this->exception_case->value != 'null')
                echo "var javascript_array = ". $this->exception_case->value . ";\n";
            else
                echo "var javascript_array = [];\n";
        ?>
        $('#name_result option').click(function(){

            $('#tree2 input[type=checkbox]').removeAttr('checked');

            var myStringArray = javascript_array[$(this).val()];

            if ( typeof myStringArray != 'undefined' )
                for (var i = 0; i < myStringArray.length; i++) {

                    $('#menus_'+myStringArray[i]).attr('checked', 'checked');

                }
        });
    }

    $(document).ready(function () {

        $('.go-back').click(function(e){
            window.location.href = $('#back_url').val();

            return false;
        });

        $( "#s_name" ).keypress(function( event ) {
            if ( event.which == 13 ) {
                event.preventDefault();
                $('.loading').remove();
                var _self = $(this);
                var targetUrl = '<?php echo HOST."staff?sname=1&name=" ?>' + $('#s_name').val();

                //get ajax content
                var aj = _self.parent().parent().next().find('.load-ajax');
                if (aj.length){
                    _self.after("<span class=\'loading\'></span>");
                    $.get(targetUrl
                        ,function(data,status){
                            aj.html(data);

                            initChoose();

                            _self.next('.loading').remove();
                        });
                }

                return false;
            }


        });
    });
</script>