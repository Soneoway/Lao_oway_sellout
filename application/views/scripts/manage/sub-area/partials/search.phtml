                <option value="2" <?php if(isset($this->params['status']) && $this->params['status'] == 2): ?> selected <?php endif; ?> > Disable </option>
            </select>
        </div>
    </div>      

    <div class="control-group">
        <div class="controls">
            <button class="btn btn-info">Search</button>
