                        <option value="<?php echo $value['staff_id'] ?>" <?php if(isset($this->params['staff_id']) && $this->params['staff_id'] == $value['staff_id']): ?> selected <?php endif; ?> >[<?php echo $value['staff_code'] ?>] <?php echo $value['staff_name'] ?></option>
                    <?php endforeach ?>
                <?php endif ?>
            </select>
        </div>
    </div>  

    <div class="control-group">
        <label class="control-label"> Status : </label>
        <div class="controls">
            <select name="status" id="status"> 
