<script type="text/javascript" src="<?php echo HOST ?>js/bootstrap-datetimepicker.min.js"></script>
<script>
    btns = '.btn_remove, .btn_reject, .btn_approve, #btn_save, #btn_bind, #btn_cancel, .btn_asm_remove';
    old_val = '';

    function palert(msg){
        $('.alert-error').remove();
        $('.page-header').after('<div class="alert alert-error">'+msg+'</div>');
        $('button').prop('disabled', false);
        return;
    }

    $(document).ready(function() {
        search_filter();
        remove_store();
        $('.edit_lbl').click(init_edit);

        $('#myTab a').click(function (e) {
            e.preventDefault();
            $(this).tab('show');
        })

        $( "#a_storename" ).keypress(function( event ) {
            if ( event.which == 13 ) {
                event.preventDefault();
                
                search_store(this);
                return false;
            }
        });

        $('#a_storename_btn').click(function() {
            search_store(this);
        });

        $('#btn_bind').click(function(){
            _self = $('#a_storeresult');
            item = _self.children('option:selected');

            for (var i = 0; i < item.length; i++) {
                if ( ! is_exists( $(item[i]).data('id') ) ) {
                    new_date = new Date().toJSON().slice(0,10);
                    elm = '<tr class="store" data-id="'+$(item[i]).data('id')+'" data-name="'+$(item[i]).data('name')+'" data-area="'+$(item[i]).data('area')+'" data-region="'+$(item[i]).data('region')+'">'
                            + '<td></td>'
                            + '<td>'+$(item[i]).data('name')+'</td>'
                            + '<td>'+$(item[i]).data('region-name')+'</td>'
                            + '<td>'+$(item[i]).data('area-name')+'</td>'
                            + '<td>\
                                    <p>\
                                        <span class="joindate">'+new_date+'</span>\
                                        <span class="label label-info edit_lbl">Edit</span>\
                                    </p>\
                                    <div class="input-append span3 edit_date" style="display:none;">\
                                        <input class="date" type="text"  data-store-id="'+$(item[i]).data('id')+'" value="'+new_date+'">\
                                        <button class="btn btn-success btn_save_date" type="button"><span class="icon-ok"></span></button>\
                                        <button class="btn btn-default btn_cancel_date" type="button"><span class="icon-remove"></span></button>\
                                    </div>\
                                </td>'
                            + '<td><button class="btn btn-warning btn-mini btn_remove">Remove</button></td>\
                                <td></td>'
                            + '</tr>';

                    $('.store_list').append(elm);
                }
            }

            $('.edit_lbl').click(init_edit);
            search_filter();
            remove_store();
        });

        $('#btn_save').click(function(){
            $('button').prop('disabled', true);

            var store = $('.store');
            id_str = '';
            
            for(var i = 0; i < store.length; i++) {
                id_str += $(store[i]).data('id') + ',';
            }
            
            id_str = id_str.replace(/\,$/, '');
            $('#store_ids').val(id_str);

            joineddate = {};
            $('.date').each(function(index, elm){
                joineddate[$(elm).data('store-id')] = $(elm).val();
            });
            
            $('#joined_dates').val(JSON.stringify(joineddate));

            $('#form').submit();
        });

        <?php if($this->access('ajax', 'approve-leader')): ?>
        $('.btn_approve').click(approveLeader);
        <?php endif; ?>
        <?php if($this->access('ajax', 'reject-leader')): ?>
        $('.btn_reject').click(rejectLeader);
        <?php endif; ?>
        <?php if($this->access('ajax', 'remove-leader')): ?>
        $('.btn_asm_remove').click(removeLeader);
        <?php endif; ?>
    });

    function search_store(elm) {
        $('button, input, select').prop('disabled', true);
                
        area_id    = $('#a_area').val();
        region_id  = $('#a_province').val();
        store_name = $('#a_storename').val();

        $('.loading').remove();
        var _self = $(elm);
        var targetUrl = '<?php echo HOST."ajax/get-store-for-leader" ?>';

        //get ajax content
        var aj = $('.load-ajax');
        if (aj.length && (area_id || region_id || store_name)){
            _self.parents('.control-group').append("<span class=\'loading\'></span>");

            $.post(targetUrl, {
                area_id : area_id,
                region_id : region_id,
                store_name : store_name,
            }, function(data){
                $('button, input, select').prop('disabled', false);
                aj.html(data);                            
                $('.loading').remove();
            });
        } else {
            $('button, input, select').prop('disabled', false);
        }
    }

    function is_exists(id) {
        _des = $('.store_list');
        items = _des.children('.store');
        for(var i = 0; i < items.length; i++) {
            if ($(items[i]).data('id') == id) {
                return true;
            }
        }
        return false;
    }

    function search_filter() {
        $('#btn_f_search').click(function() {
            area      = $('#f_area').val();
            region    = $('#f_province').val();
            storename = $('#f_storename').val();
            $('.store').show();

            $('.store').each(function() {
                _self = $(this);
                if (area && _self.data('area') != area) 
                    _self.hide();

                if (region && _self.data('region') != region) 
                    _self.hide();

                var reg = new RegExp(storename, 'gi');
                if (storename && !_self.data('name').match(reg)) 
                    _self.hide();
            });
        });

        $('#btn_f_reset').click(function() {
            $('#f_area').val('');
            $('#f_province').val('');
            $('#f_storename').val('');
            $('.store').show();
        });
    }

    function remove_store() {
        $('.btn_remove').click(function(){
            _self = $(this);
            _self.parents('tr').remove();
        });
    }

    function init_edit() {
        $self = $(this);
        $(btns).prop('disabled', true);

        $self.parent('p').nextAll('.edit_date').show();
        old_val = $self.parent('p').nextAll('.edit_date').find('.date').val();
        $self.prev('.joindate').hide();
        $self.hide();
        
        $('.date').datetimepicker({
            format : 'yyyy-mm-dd',
            autoclose : true,
            minView : 2
        });

        $('.edit_lbl').unbind('click');

        $self.parent('p').next('.edit_date').find('.btn_save_date').click(function() {
            $self = $(this);
            
            value = $self.prev('.date').val();
            $self.parent('.edit_date').prev('p').find('.joindate').text(value);
            $self.parent('.edit_date').prev('p').find('.joindate, .edit_lbl').show();

            if (value != old_val)
                $self.parents('td').addClass('modified');

            $('.edit_lbl').bind('click', init_edit);
            $(btns).prop('disabled', false);
            $self.parent('.edit_date').hide();
        });

        $self.parent('p').next('.edit_date').find('.btn_cancel_date').click(function() {
            $self = $(this);
            $self.parent('.edit_date').prev('p').find('.joindate, .edit_lbl').show();
            $('.edit_lbl').bind('click', init_edit);
            $(btns).prop('disabled', false);
            $self.parent('.edit_date').hide();
        });
    }

    <?php if($this->access('ajax', 'approve-leader')): ?>
    function approveLeader() {
        $self = $(this);
        $(btns).prop('disabled', true);
        $('.loading').remove();
        $status = $self.parents('td').next('.ajax_status');
        $status.html('<span class="loading"></span>');

        pid = $self.data('id');
        log_id = $self.data('log-id');

        $.post('<?php echo HOST ?>ajax/approve-leader', {
            pid : pid,
            log_id : log_id
        }, function(data) {
            try {
                data = $.parseJSON(data);

                if ("undefined" != typeof data.code && data.code == 1) {
                    $status.html("Approved");
                    
                    $self.next('.btn_reject').remove();
                    $self.remove();
                } else if ("undefined" != typeof data.code 
                        && "undefined" != typeof data.error) {
                    $status.html("ERROR ["+data.code+"] " + data.error);
                }
            } catch(err) {
                $status.html(err.message);
            } finally {
                $('.loading').remove();
                $(btns).prop('disabled', false);
            }
        });

        
        
    }
    <?php endif; ?>

    <?php if($this->access('ajax', 'reject-leader')): ?>
    function rejectLeader() {
        $self = $(this);
        $(btns).prop('disabled', true);
        $('.loading').remove();
        $status = $self.parents('td').next('.ajax_status');
        $status.html('<span class="loading"></span>');

        pid = $self.data('id');
        log_id = $self.data('log-id');

        $.post('<?php echo HOST ?>ajax/reject-leader', {
            pid : pid,
            log_id : log_id
        }, function(data) {
            try {
                data = $.parseJSON(data);

                if ("undefined" != typeof data.code && data.code == 1) {
                    $status.html("Rejected");

                    $self.prev('.btn_approve').remove();
                    $self.remove();
                } else if ("undefined" != typeof data.code 
                        && "undefined" != typeof data.error) {
                    $status.html("ERROR ["+data.code+"] " + data.error);
                }
            } catch(err) {
                $status.html(err.message);
            } finally {
                $('.loading').remove();
                $(btns).prop('disabled', false);
            }
        });

        
        
    }
    <?php endif; ?>

    <?php if($this->access('ajax', 'remove-leader')): ?>
    function removeLeader() {
        $self = $(this);
        $(btns).prop('disabled', true);
        $('.loading').remove();
        $status = $self.parents('td').next('.ajax_status');
        $status.html('<span class="loading"></span>');

        pid = $self.data('id');
        log_id = $self.data('log-id');

        $.post('<?php echo HOST ?>ajax/remove-leader', {
            pid : pid,
            log_id : log_id
        }, function(data) {
            try {
                data = $.parseJSON(data);

                if ("undefined" != typeof data.code && data.code == 1) {
                    $status.html("Removed");
                    $self.remove();
                } else if ("undefined" != typeof data.code 
                        && "undefined" != typeof data.error) {
                    $status.html("ERROR ["+data.code+"] " + data.error);
                }
            } catch(err) {
                $status.html(err.message);
            } finally {
                $('.loading').remove();
                $(btns).prop('disabled', false);
            }
        });

        
        
    }
    <?php endif; ?>
</script>