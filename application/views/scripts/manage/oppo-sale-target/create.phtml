        var target_max_20 = Math.round(target_max * 3);
        var target_hero_max_20 = Math.round(target_hero_max * 3);

        if ( target_sum >= target_max) {
            $('#area_target').html("<font color='green'>"+ target_sum.toLocaleString() + "</font> / " + target_max.toLocaleString());
        } else {
            $('#area_target').html("<font color='red'>"+ target_sum.toLocaleString() + "</font> / " + target_max.toLocaleString());
        }

        if ( target_hero_sum >= target_hero_max) {
