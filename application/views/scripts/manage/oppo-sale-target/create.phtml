            // } 

            // Check less than 20% Target
            if ( sum < (target_max - target_max_20) ) { $("#btn_save").attr('disabled','disabled'); } 
            else { $("#btn_save").removeAttr('disabled'); }

            if ( sum >= target_max) {
                $('#area_target').html("<font color='green'>"+ sum.toLocaleString() + "</font> / " + target_max.toLocaleString());
            } else {
                $('#area_target').html("<font color='red'>"+ sum.toLocaleString() + "</font> / " + target_max.toLocaleString());
