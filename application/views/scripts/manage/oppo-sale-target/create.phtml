            // Check less than 20% Target
            if ( sum_hero < (target_hero_max - target_hero_max_20) ) { $("#btn_save").attr('disabled','disabled'); } 
            else { $("#btn_save").removeAttr('disabled'); }


            if ( sum_hero >= target_hero_max) {
                $('#area_target_hero').html("Hero Target : <font color='green'>"+ sum_hero.toLocaleString() + "</font> / " + target_hero_max.toLocaleString());
            } else {
                $('#area_target_hero').html("Hero Target : <font color='red'>"+ sum_hero.toLocaleString() + "</font> / " + target_hero_max.toLocaleString());
