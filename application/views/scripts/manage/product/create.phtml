<form role="form" action="<?php echo HOST.'manage/product-save';?>" method="post">

    <div class="form-group">
        <label for="name">Name</label>
        <input type="text" class="form-control" id="name" name="name" required="required" value="<?php if (isset($this->product)): echo $this->product->name; endif;?>">
