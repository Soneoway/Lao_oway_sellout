    <div class="form-group">
        <label for="retailer_price">Retailer Price</label>
        <input type="number" class="form-control" id="retailer_price" name="retailer_price" value="<?php if (isset($this->product)): echo $this->product->retailer_price; endif;?>">
    </div>

    <div class="form-group">
        <label>Model</label>
        <?php if ($this->models) :?>
        <?php foreach ($this->models as $model) :?>
        <p class="p-model">
            <input type="text" class="form-control" name="models[]" value="<?php echo $model->model;?>" />
            <button type="button" class="btn-danger remove-model form-control"><i class="icon-minus"></i></button>
