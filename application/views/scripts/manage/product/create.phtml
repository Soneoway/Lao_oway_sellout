        <?php endif;?>
        <label><button type="button" class="btn-success add-model"><i class="icon-plus"></i></button></label>
    </div>

    <input type="hidden" name="removed_models" id="removed_models" />
    <input type="hidden" name="id" id="id" value="<?php isset($this->product) and $this->product and printf($this->product->id);?>">
    <button type="submit" class="btn btn-primary">Submit</button>
    <input type="hidden" name="back_url" id="back_url" value="<?php isset($this->back_url) and $this->back_url and printf($this->back_url);?>">
    <button type="button" class="btn btn-danger go-back">Go back</button>
</form>
<script type="text/javascript">
    $(document).ready(function () {
        $('.go-back').click(function(e){
            window.location.href = $('#back_url').val();

            return false;
        });

        initRemove();
        $( '.add-model' ).click(function (){
            var new_model = '<p class="p-model"><input type="text" class="form-control" name="models[]" /> <button type="button" class="btn-danger remove-model form-control"><i class="icon-minus"></i></button></p>';
            $(new_model).insertBefore($(this).parent());
            initRemove();
            return false;
        });
    });

    function initRemove(){
        $( '.remove-model' ).click(function (){
            var removed = $(this).parent().find('input[type=hidden]').val();
            if (typeof removed != 'undefined'){
                var removed_list = $('#removed_models').val();
                if (removed_list=='')
                    $('#removed_models').val(removed);
                else
                    $('#removed_models').val(removed_list+','+removed);
            }

            $(this).parent().remove();

            return false;
        });
    }
</script>