    <div class="form-group">
        <label for="distributor_price">Distributor's Price</label>
        <input type="number" class="form-control" id="distributor_price" name="distributor_price" value="<?php if (isset($this->product)): echo $this->product->distributor_price; endif;?>">
    </div>

    <div class="form-group">
        <label for="price_2">II Agency Price</label>
        <input type="number" class="form-control" id="price_2" name="price_2" value="<?php if (isset($this->product)): echo $this->product->price_2; endif;?>">
