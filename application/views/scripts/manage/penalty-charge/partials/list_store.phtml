        <?php 
            $Store = new Application_Model_Store();

            if ($this->penalty_list) {
                $data = $this->penalty_list;

                //print_r($data);

                for($i=0;$i<count($data);$i++) { 

                    $role_list = '';
                    if ($data[$i]['flag_gfk'] == 1) { $role_list .= ' <span class="label label-success">GFK</span>'; }
                    if ($data[$i]['flag_rd'] == 1) { $role_list .= ' <span class="label label-success">RD</span>'; }
                    if ($data[$i]['flag_asm'] == 1) { $role_list .= ' <span class="label label-success">ASM</span> <span class="label label-success">ASM Stand By</span>'; }
                    if ($data[$i]['flag_sale'] == 1) { $role_list .= ' <span class="label label-success">Sale</span>'; }
                    if ($data[$i]['flag_pc'] == 1) { $role_list .= ' <span class="label label-success">PC</span>'; }

                    $role_list = rtrim($role_list, ",");

                    $store_id = explode(",", $data[$i]['store']);

                    $where = $Store->getAdapter()->quoteInto('id IN (?)', $store_id);
                    $result = $Store->fetchAll($where)->ToArray();

                    $store_list = '';
                    for ($j=0;$j<count($result);$j++) {
                        $store_list .= "[ ".$result[$j]['id']." ] ".$result[$j]['name']."<br/>"; 
                    }

                    $cnt = $i + 1;
                    echo "<tr>";
                    echo    "<td><div align='center'>".$cnt."</div></td>";
                    echo    "<td><div align='center'>".$data[$i]['from_date']."</div></td>";
                    echo    "<td><div align='center'>".$data[$i]['to_date']."</div></td>";
                    echo    "<td><div align='center'>".$role_list."</div></td>";
                    echo    "<td><div align='left'>".$store_list."</div></td>";
                    echo    "<td><div align='left'>".$data[$i]['remark']."</div></td>";
                    echo    "<td>
                                <div align='center'>
                                    <a title='Edit' href='/manage/penalty-charge-create-store?id=".$data[$i]['id']."'> <i class='icon-edit'></i></a>
                                    <a title='Delete' class='confirmLink' href='/manage/penalty-charge-store-del?id=".$data[$i]['id']."'> <i class='icon-trash'></i></a>
                                </div>
                            </td>";
                    
                    echo "</tr>";
                }

            }
        ?>
    </tbody>
</table>

