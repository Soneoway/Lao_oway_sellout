<table class="table table-bordered">
    <thead>
    <tr>
        <th><div align="center">No.</div></th>
        <th><div align="center">From</div></th>
        <th><div align="center">To</div></th>
        <th><div align="center">Role</div></th>
        <th><div align="center">Store</div></th>
