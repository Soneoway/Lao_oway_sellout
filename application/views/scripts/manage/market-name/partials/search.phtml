<form class="form-search form-horizontal" method="get" action="/manage/market-name/market-name">
    <div class="row">
        <div class="span5">
	       <div class="control-group">
                <label for="market_name_id" class="span2">Market Name ID</label>
                <input id="market_name_id" name="market_name_id" type="text" class="input-medium search-query form-control" value="<?php isset($this->params['market_name_id']) and printf($this->params['market_name_id']);?>">
