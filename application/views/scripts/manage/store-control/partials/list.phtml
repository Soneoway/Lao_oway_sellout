            $StoreControl = new Application_Model_StoreControl();

            if ($this->store_control) {
                $data = $this->store_control;

                for($i=0;$i<count($data);$i++) { 

                    $cnt_sc = $StoreControl->cnt_store_by_area($data[$i]['sc_id']);

                    $cnt = $i + 1;
                    echo "<tr>";
                    echo    "<td>".$cnt."</td>";
                    echo    "<td>
                                <a title='Edit' href='".HOST."manage/store-control-edit?store_control_id=".$data[$i]['sc_id']."'>".$data[$i]['sc_name']."</a>
                            </td>";

                    echo    "<td>";
                    for ($j=0;$j<count($cnt_sc);$j++) { echo "<div>".$cnt_sc[$j]['area_name']." ( ".$cnt_sc[$j]['cnt_store']." )</div>"; }
                    echo    "</td>";

                    echo    "<td><div align='center'>".$data[$i]['staff_code']."</div></td>";
                    echo    "<td>".$data[$i]['staff_name']."</td>";
                    echo    "<td><div align='center'>".$data[$i]['staff_group']."</div></td>";
                    echo    "<td>
                                <div align='center'>
                                    <a title='Edit' href='/manage/store-control-store-edit?id=".$data[$i]['sc_id']."'><i class='icon-edit'></i></a>
                                    <a title='Delete' class='confirmLink' href='/manage/store-control-del?id=".$data[$i]['sc_id']."'> <i class='icon-trash'></i></a>
                                    <span class='badge badge-default' data-store-control-id='".$data[$i]['sc_id']."'>Log</span>
                                </div>
                            </td>";
                    echo "</tr>";
                }

            }
        ?>
