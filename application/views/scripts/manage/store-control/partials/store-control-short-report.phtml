    $sc_log = $this->sc_log;
    for ($i=0;$i<count($sc_log);$i++) {

      if ($sc_log[$i]['off_date']) {
        $off_tmp = explode("-", $sc_log[$i]['off_date']);
        $off_date = $off_tmp[2]."/".$off_tmp[1]."/".$off_tmp[0];
      } else { $off_date = ""; }

      if ($sc_log[$i]['from_date']) {
        $from_tmp1 = explode(" ", $sc_log[$i]['from_date']);
        $from_tmp2 = explode("-", $from_tmp1[0]);
        $from_date = $from_tmp2[2]."/".$from_tmp2[1]."/".$from_tmp2[0]." ".$from_tmp1[1];
      } else { $from_date = ""; }

      if ($sc_log[$i]['to_date']) {
        $to_tmp1 = explode(" ", $sc_log[$i]['to_date']);
        $to_tmp2 = explode("-", $to_tmp1[0]);
        $to_date = $to_tmp2[2]."/".$to_tmp2[1]."/".$to_tmp2[0]." ".$to_tmp1[1];
      } else { $to_date = ""; }

      echo "<tr >";
      echo    "<td align=\"center\">".$sc_log[$i]['staff_code']."</td>";
      echo    "<td>".$sc_log[$i]['staff_name']."</td>";
      echo    "<td align=\"center\">".$sc_log[$i]['staff_group']."</td>";
      echo    "<td align=\"center\">".$off_date."</td>";
      echo    "<td align=\"center\">".$from_date."</td>";
      echo    "<td align=\"center\">".$to_date."</td>";
      echo "</tr>";
    } 
  ?>
