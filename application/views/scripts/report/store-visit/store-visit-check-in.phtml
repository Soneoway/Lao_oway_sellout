<script>
// กำหนดจุดศูนย์กลางและรัศมี (100 เมตร)
const center = [<?php echo $this->store->lat ?>, <?php echo $this->store->lng ?>]; // ตัวอย่าง: กรุงเทพฯ
const radius = 100; // รัศมี 100 เมตร

console.log(center);

// ฟังก์ชันคำนวณระยะทางระหว่างสองจุด (Haversine formula)
function calculateDistance(lat1, lon1, lat2, lon2) {
    const R = 6371e3; // รัศมีของโลกในหน่วยเมตร
    const φ1 = (lat1 * Math.PI) / 180;
    const φ2 = (lat2 * Math.PI) / 180;
    const Δφ = ((lat2 - lat1) * Math.PI) / 180;
    const Δλ = ((lon2 - lon1) * Math.PI) / 180;

    const a =
        Math.sin(Δφ / 2) * Math.sin(Δφ / 2) +
        Math.cos(φ1) * Math.cos(φ2) * Math.sin(Δλ / 2) * Math.sin(Δλ / 2);
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));

    return R * c; // ระยะทางในหน่วยเมตร
}

// ฟังก์ชันแสดงแผนที่และตำแหน่ง
function initMap() {
    const map = L.map('map').setView(center, 15);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors'
    }).addTo(map);

    // วาดวงกลมแสดงรัศมี 100 เมตร
    L.circle(center, {
        color: 'red',
        fillColor: '#f03',
        fillOpacity: 0.2,
        radius: radius
    }).addTo(map);

    // ดึงตำแหน่งปัจจุบันของผู้ใช้
    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(
            (position) => {
                const userLat = position.coords.latitude;
                const userLng = position.coords.longitude;

                // แสดงตำแหน่งผู้ใช้บนแผนที่
                const userMarker = L.marker([userLat, userLng]).addTo(map);
                userMarker.bindPopup("ທີ່ຢູ່ປັດຈຸບັນຂອງທ່ານ").openPopup();

                // คำนวณระยะทางจากจุดศูนย์กลาง
                const distance = calculateDistance(center[0], center[1], userLat, userLng);

                // ตรวจสอบว่าอยู่ในรัศมีหรือไม่
                const statusElement = document.getElementById('status');
                const checkinBtn = document.getElementById('checkinBtn');

                if (distance <= radius) {
                    statusElement.textContent =
                        `ທ່ານຢູ່ໃນພື້ນທີ່ລັດສະໝີ ${radius} ເມັດ (ໄລຍະທາງແມ່ນ: ${distance.toFixed(2)} ເມັດ)`;
                    statusElement.style.color = 'green';
                    checkinBtn.disabled = false; // เปิดปุ่มเช็กอิน
                    checkinBtn.style.display = 'block'; // แสดงปุ่ม
                } else {
                    statusElement.textContent =
                        `ບໍ່ສາມາດດຳເນີການຕໍ່ໄດ້ ເພາະທ່ານຢູ່ນອກພື້ນທີ່ລັດສະໝີ ${radius} ເມັດ (ໄລຍະທາງແມ່ນ: ${distance.toFixed(2)} ເມັດ)`;
                    statusElement.style.color = 'red';
                    checkinBtn.disabled = true; // ปิดปุ่มเช็กอิน
                    checkinBtn.style.display = 'none'; // ซ่อนปุ่ม
                }
            },
            (error) => {
                alert('ບໍ່ສາມາດເຂົ້າເຖິງຕຳແໜ່ງໄດ້: ' + error.message);
            }
        );
    } else {
        alert('ບຣາວເຊີບໍ່ຮອງຮັບການເຂົ້າເຖິ່ງແຜນທີ່');
    }
}

// ฟังก์ชันเช็กอิน
document.getElementById('checkinBtn').onclick = function() {
    alert('ດຳເນີນການຂັ້ນຕອນຕໍ່ໄປ!');
    // สามารถส่งข้อมูลไปยังเซิร์ฟเวอร์ได้ที่นี่
};

// เริ่มต้นแผนที่เมื่อโหลดหน้าเว็บ
window.onload = initMap;


$('.go-back').click(function(e) {

    window.location.href = $('#back_url').val();

    return false;
});

</script>