<script>
var map = L.map('map').setView([17.9627758, 102.6184226], 13); // กำหนดค่าเริ่มต้น (กรุงเทพฯ)

// เพิ่มแผนที่จาก OpenStreetMap
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; OpenStreetMap contributors'
}).addTo(map);

// ตรวจสอบว่าบราวเซอร์รองรับ Geolocation หรือไม่
if (navigator.geolocation) {
    navigator.geolocation.watchPosition(function(position) {
        var lat = position.coords.latitude;
        var lng = position.coords.longitude;

        // ลบ marker เก่า ถ้ามี
        if (typeof marker !== 'undefined') {
            map.removeLayer(marker);
        }

        // สร้าง marker ใหม่
        var marker = L.marker([lat, lng]).addTo(map)
            .bindPopup("ຕຳເເໜ່ງປັດຈຸບັນຂອງທ່ານ")
            .openPopup();

        // อัปเดตตำแหน่งแผนที่
        map.setView([lat, lng], 15);

        const u_lat = $('#lat').val(lat);
        const u_lng = $('#lng').val(lng);

    }, function(error) {
        console.error("ເກິດຂໍ້ຜິດພາດໃນການເຂົ້າເຖິງຕຳເເໜ່ງ : ", error);
    });
} else {
    alert("ບຣາວເຊີບໍ່ຮອງຮັບການເຂົ້າເຖິ່ງແຜນທີ່");
}

let marker;

function getLocation() {
    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(showPosition, showError);

    } else {
        alert("ບາວເຊີບໍ່ຮອງຮັບ GPS");
    }
}

function showPosition(position) {
    let lat = position.coords.latitude;
    let lng = position.coords.longitude;

    if (marker) map.removeLayer(marker);
    marker = L.marker([lat, lng]).addTo(map).bindPopup("ຕຳແໜ່ງຂອງທ່ານ").openPopup();
    map.setView([lat, lng], 15);

    checkIn(lat, lng);

}


function showError(error) {
    alert("ບໍສາມາດດືງຂໍ້ມູນຕຳເເໜ່ງໄດ້");
}

$(document).ready(function() {

    const store_id = $('#store_id').val();

    navigator.geolocation.watchPosition(function(position) {
        $("#checkin-btn").click(function() {
            $.ajax({
                type: 'post',
                url: '/report/save-store-location',
                data: {
                    'store_id': store_id,
                    'lat': position.coords.latitude,
                    'lng': position.coords.longitude
                },
                error: function(error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'AJAX Error',
                        text: 'There was an error with the AJAX request: ' +
                            error,
                        confirmButtonText: 'Okay'
                    });
                },
                success: function(data) {
                    Swal.fire({
                        icon: 'success',
                        title: 'ບັນທຶກແຜນທີ່ຮ້ານຄ້າສຳເລັດ',
                        showConfirmButton: false,
                        timer: 1500
                    }).then(function() {
                        window.location.href = '/report/store-visit';
                    })
                }
            });

        });

    });

});

$('.go-back').click(function(e){
    
window.location.href = $('#back_url').val();

return false;
});

</script>