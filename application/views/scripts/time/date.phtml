<script>
    <?php if ($this->access('time', 'date')): ?>
    
    $(document).ready(function() {
        $('.editable .value').click(show_edit_form);
    });


    old_value = 0;

    function show_edit_form(e) {
        e.preventDefault();

        _self = $(e.target);
        _self.hide();

        old_value = _self.data('value');

        _form = _self.parent('.editable').find('.form');
        _form.show();
        
        _form.keypress(save_date);

        $('.editable .value').unbind('click');
    }

    function save_date(e) {
        if (e.which == 13) {
            e.preventDefault();

            _self = $(e.target);

            date = 0;
            id = _self.data("id");

            try {
                date = parseInt( _self.val().trim() );
            } catch (err) {
                console.log(err.message);
                return false;
            }

            $.ajax({
                url: '<?php echo HOST ?>time/date-update',
                type: 'post',
                dataType: 'json',
                data: {
                    date : date,
                    id : id,
                },
            })
            .done(function(data) {
                console.log("success");
                    window.location.reload();                
            })
            .fail(function() {
                console.log("error");
            })
            .always(function() {
                console.log("complete");
            });
            
        }
    }

    <?php endif; ?>
</script>

