                                <span class="form" style="display:none;">
                                    <input type="text" data-id="<?php echo $v['id'] ?>" class="form-control target" value="<?php echo $v['date'] ?>">
                                </span>
                            </div>
</td>
                    <td><a target="_blank" href="<?php echo HOST?>time/date-special?month=<?php echo $k+1 ?>" class="value" data-value="<?php echo $v['date'] ?>">Add special date</a></td>
