        if (typeof _is_head_office !== 'undefined'){
            var $isNotHeadOffice = checkNotHeadOffice($('#department').val(), $('#team').val(), $('#title').val());
            if ($isNotHeadOffice){
                _is_head_office.removeAttr('checked');
            } else{
                _is_head_office.attr('checked', 'checked');
            }
        }
    }

