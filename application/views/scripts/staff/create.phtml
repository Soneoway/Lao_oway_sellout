        _item.find('.save_rlt_btn').click(save_rlt).show();
        _item.find('.cancel_rlt_btn').click(cancel_rlt).show();

        $('.item').removeClass('new');

    }

    function cancel_rlt(e) {
        _item = $(e.target).parents('.item');
        $('#alert').text('').fadeOut();

        id = _item.find('.relative_id').val();

        if (id) {
            _item.find('input, select, label').hide();
            _item.find('.editable').show();
            _item.find('.save_rlt_btn, .cancel_rlt_btn').unbind('click').hide();
            _item.find('.edit_rlt_btn').click(show_edit_rlt).show();
            _item.find(".confirmLink").click(delete_item);
        } else {
            _item.remove();
        }       

        $('.add_relative_btn').bind('click', load_add_relative).prop('disabled', false);
    }
    /////////////////////////////////
    function delete_item(e) {
        e.preventDefault();
        $('#alert').text('').fadeOut();
        
        var targetUrl = $(this).attr("href");

        $("#dialog").dialog({
            buttons : {
                "Confirm" : function() {
                    $('.loading').remove();
                    _item = $(e.target).parents('.item');
                    _item.find('button').prop('disabled', true);
                    _item.find('td').last().append('<span class="loading"></span>');
                    $("#dialog").dialog("close");

                    $.ajax({
                        url: targetUrl,
                        type: 'get',
                        dataType: 'json'
                    })
                    .done(function(data) {
                        console.log("success");

                        $('.loading').remove();
                        _item.find('button').prop('disabled', false);

                        if (data && typeof data.result !== "undefined" && data.result) {
                            _item.remove();
                            _item = $(e.target).parents('.item');
                        } else if (data && typeof data.error != 'undefined') {
                            $('#alert').text(data.error).fadeIn();
                        }
                    })
                    .fail(function() {
                        console.log("error");
                    })
                    .always(function() {
                        console.log("complete");
                    });
                    
                },
                "Cancel" : function() {
                    $(this).dialog("close");
                }
            }
        });

        $("#dialog").dialog("open");
    }

