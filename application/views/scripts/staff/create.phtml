    function save_edu(e) {
        _item = $(e.target).parents('.item');

        $('.loading').remove();
        $('#alert').text('').fadeOut();
        
        id             = _item.find('.education_id').val();
        staff_id       = _item.find('.staff_id').val();
        level          = _item.find('.level').val();
        school         = _item.find('.school').val();
        field_of_study = _item.find('.field_of_study').val();
        graduated_year = _item.find('.graduated_year').val();
        grade          = _item.find('.grade').val();
        mode_of_study  = _item.find('.mode_of_study').val();

        if (staff_id) {
            _item.find('input, button').prop('disabled', true);
            _item.find('td').last().append('<span class="loading"></span>');

            $.ajax({
                url: '<?php echo HOST ?>ajax/staff-edu-save',
                type: 'post',
                dataType: 'json',
                data: {
                    id             : id,
                    staff_id       : staff_id,
                    level          : level,
                    school         : school,
                    field_of_study : field_of_study,
                    graduated_year : graduated_year,
                    grade          : grade,
                    mode_of_study  : mode_of_study
                },
            })
            .done(function(data) {
                console.log("success");

                try {
                    $('.loading').remove();
                    $('.add_education_btn').bind('click', load_add_education).prop('disabled', false);

                    if (data && typeof data.result !== "undefined" && data.result && data.id) {
                        _item.find('.level_txt').text( level );
                        _item.find('.school_txt').text( school );
                        _item.find('.field_of_study_txt').text( field_of_study );
                        _item.find('.graduated_year_txt').text( graduated_year );
                        _item.find('.grade_txt').text( grade );
                        _item.find('.mode_of_study_txt').text( mode_of_study );

                        _item.find('.education_id').val( data.id );

                        _item.find('input, button').prop('disabled', false);
                        _item.find('input').hide();
                        _item.find('button').unbind('click').hide();
                        _item.find('.edit_btn').show();
                        _item.find('.edit_btn').click(show_edit_edu);
                        _item.find(".confirmLink").click(delete_item);
                        _item.find('.editable').show();

                    } else if (data && typeof data.error != 'undefined') {
                        $('#alert').text(data.error).fadeIn();
                    }
                } catch(err){ console.log (err); }
            })
            .fail(function() {
                console.log("error");
            })
            .always(function() {
                console.log("complete");
            });
            
        }

    }

