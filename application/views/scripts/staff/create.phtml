    function load_log_info(e) {
        _item  = $(e.target).parents('.item');
        parent = $(e.target).parents('td');
        type   = $(e.target).val();
        staff  = _item.find('.staff_id').val();

        $('.loading').remove();
        parent.nextAll('td').html('');
        parent.append('<span class="loading"></span>');

        $.ajax({
            url: '<?php echo HOST ?>partition/staff-transfer',
            type: 'post',
            dataType: 'html',
            data: {type : type, staff : staff},
        })
        .done(function(html) {
            console.log("success");
            parent.nextAll('td').remove();
            parent.after(html);
            _item.find( '.date' ).datepicker({ dateFormat: "dd/mm/yy" });
            $('.save_transfer_btn').click(save_transfer);
            $('.cancel_transfer_btn').click(cancel_transfer);
            $('.loading').remove();
        })
        .fail(function() {
            console.log("error");
        })
        .always(function() {
            console.log("complete");
        });
        
    }

    function save_transfer() {
        var staff_id        = '<?php echo $this->staff_id;?>';
        var company         = $("#transfer_modal .company").val();
        var area_id         = $('#transfer_modal .area_id').val();
        var regional_market = $('#transfer_modal .regional_market').val();
        var department      = $("#transfer_modal .department").val();
        var team            = $("#transfer_modal .team").val();
        var from_date       = $("#transfer_modal .from_date").val();
        var group           = $("#transfer_modal .group").val();
        var title           = $("#transfer_modal .title").val();
        var transfer_id     = $("#transfer_modal .transfer_id").val();
        var params = {'staff_id':staff_id,'company':company,'area_id':area_id,'regional_market':regional_market,
            'department':department,'team':team,'from_date':from_date, 'group':group,'title':title,'transfer_id':transfer_id
        };
        $.ajax({
            type: 'get',
            url: "<?php echo HOST.'staff/save-transfer';?>",
            data: params,
            dataType: 'json',
            success: function(data){
                if(data.status == 0){
                    $(".message_error").html('ERROR: '+data.message);
                }else{
                    loadTableTransfer(staff_id);
                    $('#transfer_modal').modal('hide');

                    //update basic form
                    $('#department').val(department);
                    $('#team').val(team);
                    $('#status').val(status);
                    $('#area_id').val(area_id);
                    $('#regional_market').val(regional_market);
                    $('#company_id').val(company);
                    $("#group").val(group);
                    $("#title").val(title);
                    $('#transfer_modal').modal('hide');

                }
            }
        });
    }

