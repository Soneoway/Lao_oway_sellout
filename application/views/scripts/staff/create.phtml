    function initPreview(){
        $('.has-preview').change(function (){
            readURL($(this));
        });
    }

    function readURL(jqueryObject) {
        var input = $(jqueryObject).get(0);

        if (input.files && input.files[0]) {
            var reader = new FileReader();

            reader.onload = function (e) {
                $(jqueryObject).next('.gen-img-preview').remove();
                $(jqueryObject).after('<img class="gen-img-preview" width="150" height="150" />');
                $(jqueryObject).next('.gen-img-preview').attr('src', e.target.result);
            };

            reader.readAsDataURL(input.files[0]);
        }
    }
    checkSizeIDCard();
    function checkSizeIDCard(){
        $("#id_photo,#id_photo_back").change(function(){
            var _this = $(this);
            var iSize = ($(this)[0].files[0].size / 1024);
            if(iSize > 2048){
                _this.replaceWith(_this = _this.clone(true));
                iSize = (Math.round(iSize / 1024 * 100) / 100);
                var mess = '<div><p>Image size must be less than 2MB, current file size is: '+iSize +' Mb</p></div>';
                $(mess).dialog({
                    title: 'Confirm',
                    resizable: false,
                    buttons: {
                        'Ok':function(){
                            $(this).dialog('close');
                        }
                    }
                });
            }
        });
    }

    initCheckDefaultLevel();
    function initCheckDefaultLevel(){
        $('#form').submit(function(e){
            
            var num = $('.default_level').length;
            if(num >= 1){
                var check = 0;
                $('.default_level').each(function(){
                    if($(this).val() == 1){
                        check = 1;
                    }
                });
                if(check == 0){
                    $("<div><p>Please select default level</p></div>").dialog({
                        title: 'Confirm',
                        resizable: false,
                        buttons: {
                            'Ok':function(){
                                $(this).dialog('close');
                                $('button[type=submit]').prop('disabled', false);
                            }
                        }
                    });
                    return false;
                }
            }
            
        });

        $('.default_level').change(function(){
            var _this = $(this);
            if(_this.val() == 1){
                $(".default_level").val(0);
                _this.val(1);
            }
        })
    }

