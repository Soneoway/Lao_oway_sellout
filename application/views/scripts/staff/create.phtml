    var check_id_timeout;

    function do_check_id_card_number(e) {
        window.clearTimeout(check_id_timeout);

        check_id_timeout = window.setTimeout(function() {
            var id_number = $('#ID_number').val().trim();
            var staff_id = $('#ID_number').data('id');
            check_id_card_number(id_number, staff_id);
        }, 500);
    }

    function check_id_card_number(id_number, staff_id) {
        $('#id_card_validate').html('');

        $.ajax({
            url: '<?php echo HOST ?>ajax/check-id-number',
            type: 'post',
            dataType: 'html',
            data: {id_number: id_number, id: staff_id},
        })
        .done(function(html) {
            console.log("success");

            if (html) $('#id_card_validate').html(html);
        })
        .fail(function() {
            console.log("error");
        })
        .always(function() {
            console.log("complete");
        });
        
    }

    function load_district(e) {
        $('.loading').remove();

        _self = $(e.target);
        province_id = _self.val();

        console.log(province_id);

        if (province_id) {
            _self.after('<span class="loading"></span>');
            $('button, input, select, textarea').prop('disabled', true);
            $('form').bind('submit',function(e){e.preventDefault();});

            $.ajax({
                url: '<?php echo HOST ?>ajax/get-district-cbb',
                type: 'post',
                dataType: 'json',
                data: {region: province_id},
            })
            .done(function(data) {
                console.log("success");
                district_cbb = _self.parents('fieldset').find('.district')
                district_cbb.find('option:not(:first)').remove();

                try {
                    for (index in data) {
                        district_cbb.append('<option value="'+data[index]['id']+'">'+data[index]['name']+'</option>');
                    }
                } catch (err) {}
            })
            .fail(function() {
                console.log("error");
            })
            .always(function() {
                console.log("complete");

                $('button, input, select, textarea').prop('disabled', false);
                $('form').unbind('submit');
                $('.loading').remove();
            });
            
        }
    }
