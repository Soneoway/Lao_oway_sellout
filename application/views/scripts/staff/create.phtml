    function updateTransfer(e){
        var transfer_id = $(this).attr('data-transfer');
        $('#myModalLabel').html('Update Transfer')
        $.ajax({
            type: 'get',
            url: '<?php echo HOST.'ajax/get-transfer-info'?>',
            data: {'transfer_id': transfer_id},
            dataType: 'json',
            success: function(data){
                if(data.code == 1){
                    alert(data.message);
                }else{
                    $("#transfer_modal .company").val(data.result.company);
                    $("#transfer_modal .area_id").val(data.result.area);
                    $("#transfer_modal .region_tmp").val(data.result.region);
                    $('.area_id').trigger('change');
                    //$("#transfer_modal .regional_market").val(data.result.region);
                    $("#transfer_modal .department").val(data.result.department);
                    $("#transfer_modal .team").val(data.result.team);
                    $("#transfer_modal .group").val(data.result.group);
                    $("#transfer_modal .title").val(data.result.title);
                    $("#transfer_modal .from_date").val(data.result.from_date);
                    $("#transfer_modal .transfer_id").val(transfer_id);
                    $('.message_error').html('');
                    $('#transfer_modal').modal('show');
                }
            }
        });
    }

    function deleteTransfer(e){
        e.preventDefault();
        var staff_id   = '<?php echo $this->staff_id;?>';
        var _this = $(this);
        var link = $(this).attr('href');
        $("#dialog").dialog({
            buttons:{
                'Ok':function(){
                    $.ajax({
                        type: 'get',
                        url: link,
                        success:function(data){
                            if(data.code == 1){
                                alert(data.message);
                            }else{
                                loadTableTransfer(staff_id);
                                console.log(data.message);
                            }
                        }
                    });
                    $(this).dialog('close');
                },
                'Cancel':function(){
                    $(this).dialog('close');
                }
            }
        });
        $("#dialog").dialog("open");
    }

