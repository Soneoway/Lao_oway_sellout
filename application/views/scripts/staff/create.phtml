    function checkNotHeadOffice(department_id, team_id, title_id){
        var JSONString = '<?php echo json_encode(unserialize(CONFIG_NOT_HEAD_OFFICE));?>';
        var $arrNotHeadOffice = JSON.parse(JSONString);

        for (var key in $arrNotHeadOffice) {
            if ($arrNotHeadOffice[key] == department_id)
                return true;

            if (typeof $arrNotHeadOffice[key] === 'object'){
                for (var key2 in $arrNotHeadOffice[key]){
                    if (key2 == team_id){
                        for (var key3 in $arrNotHeadOffice[key][key2]){
                            if (key3 == title_id){
                                return true;
                            }
                        }
                    }
                }
            }

        }
        return false;
    }

    function initSelectHeadOffice(){
