</div>

<script type="text/javascript">
	$modal = $('#modal');
	
	$('.note_label').click(function(){
	    var _self = $(this);

	    $('body').modalmanager('loading');
	    $('#note_content').html(_self.data('note'));
	    $('#note_id').val(_self.data('id'));
       
	    $modal.modal('loading');
        noteid=_self.data('id');

        $.ajaxSetup({
            cache: true
        });

	    $.post('<?php echo HOST ?>/staff/quick-edit',
                {
                    id            : noteid,
                   	back_url : '<?php echo HOST.$this->current_url; ?>'
                },
                function(data){
                    $modal.html(data);
                    $modal.modal();
                    var name = _self.parents('tr').children('td:nth-child(2)').html();
                    $modal.find('h3').append(' <small>&bull; '+name+'</small>');
            });
	});
    
    
    </script>
  
    <script type="text/javascript" src="/js/jquery-ui-1.8.12.custom.min.js"></script>
